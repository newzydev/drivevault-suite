; DriveVault Master Pro - Windows installer (Inno Setup 6.x). Built by scripts\package.ps1.
; Master Pro lives directly in the suite folder (C:\Program Files\DriveVault); every DriveVault program installs into its own sub folder.
; The program installers run this setup silently when Master Pro is missing or older, so it is always there before a program.

#ifndef AppVersion
  #define AppVersion "1.4.7"
#endif
#ifndef StageDir
  #error StageDir must point at the deployed application folder (see scripts\package.ps1)
#endif
#ifndef OutputDir
  #define OutputDir "..\..\dist"
#endif

#define AppName "DriveVault Master Pro"
#define AppExe "DriveVaultMasterPro.exe"
#define AppPublisher "DriveVault"

[Setup]
; AppId identifies the product across versions - never change it once released.
AppId={{B3A7C1D4-5E2F-4A86-9C10-7D2E8F4A6B35}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
VersionInfoVersion={#AppVersion}.0
VersionInfoProductName={#AppName}
VersionInfoCompany={#AppPublisher}
VersionInfoDescription={#AppName} Setup
DefaultDirName={autopf}\DriveVault
; The folder is fixed (suite contract): no folder page. Only the command line /DIR can change it.
DisableDirPage=yes
DefaultGroupName=DriveVault
DisableProgramGroupPage=yes
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName={#AppName}
SetupIconFile=..\..\resources\icons\app.ico
WizardImageFile=wizard-large.bmp
WizardSmallImageFile=wizard-small.bmp
OutputDir={#OutputDir}
OutputBaseFilename=DriveVault-Master-Pro-Setup-x64
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
MinVersion=10.0
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; All users by default (C:\Program Files\DriveVault). The program installers pass /ALLUSERS or /CURRENTUSER to match their own scope.
PrivilegesRequired=admin
PrivilegesRequiredOverridesAllowed=dialog commandline
ShowLanguageDialog=yes
UsePreviousLanguage=no
LanguageDetectionMethod=uilanguage
CloseApplications=yes
RestartApplications=no
; The licence page shows the English or the Thai agreement (generated by shared\scripts\make-license.ps1)

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"; LicenseFile: "license-en.txt"
Name: "thai"; MessagesFile: "compiler:Languages\Thai.isl"; LicenseFile: "license-th.txt"

[CustomMessages]
english.DesktopTask=Create a &desktop shortcut
english.ProductsInstalled=DriveVault programs are still installed. DriveVault Master Pro manages them, so it can only be uninstalled after they have been uninstalled.%n%nOpen Master Pro to uninstall them first.
thai.DesktopTask=สร้างทางลัดบน&เดสก์ท็อป
thai.ProductsInstalled=ยังมีโปรแกรม DriveVault ติดตั้งอยู่ DriveVault Master Pro เป็นตัวจัดการโปรแกรมเหล่านั้น จึงถอนการติดตั้งได้ต่อเมื่อถอนโปรแกรมทั้งหมดแล้ว%n%nเปิด Master Pro เพื่อถอนโปรแกรมเหล่านั้นก่อน

[Tasks]
Name: "desktopicon"; Description: "{cm:DesktopTask}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Dirs]
; where setup files of the DriveVault programs can be put for installing / updating from Master Pro
Name: "{app}\installers"

[Files]
Source: "{#StageDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\{#AppExe}"; WorkingDir: "{app}"
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon

[Registry]
Root: HKA; Subkey: "Software\DriveVault"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "Software\DriveVault\MasterPro"; ValueType: string; ValueName: "DisplayName"; ValueData: "{#AppName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\DriveVault\MasterPro"; ValueType: string; ValueName: "Version"; ValueData: "{#AppVersion}"
Root: HKA; Subkey: "Software\DriveVault\MasterPro"; ValueType: string; ValueName: "InstallDir"; ValueData: "{app}"
Root: HKA; Subkey: "Software\DriveVault\MasterPro"; ValueType: string; ValueName: "Executable"; ValueData: "{app}\{#AppExe}"
Root: HKA; Subkey: "Software\DriveVault\MasterPro"; ValueType: string; ValueName: "AccentColor"; ValueData: "#F59E0B"
Root: HKA; Subkey: "Software\DriveVault\MasterPro"; ValueType: string; ValueName: "Publisher"; ValueData: "{#AppPublisher}"

[Run]
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent

[Code]
function HasProducts(Root: Integer): Boolean;
var
  Names: TArrayOfString;
begin
  Result := RegGetSubkeyNames(Root, 'Software\DriveVault\Products', Names) and (GetArrayLength(Names) > 0);
end;

// The hub manages the programs: while any of them is installed it stays (a silent uninstall is refused too).
function InitializeUninstall(): Boolean;
begin
  Result := True;
  if HasProducts(HKLM64) or HasProducts(HKCU64) or HasProducts(HKLM32) or HasProducts(HKCU32) then
  begin
    MsgBox(CustomMessage('ProductsInstalled'), mbError, MB_OK);
    Result := False;
  end;
end;

// Settings and the list of installer folders belong to the user: they stay unless the folder is empty.
// The suite folder is shared: it was created by whichever installer ran first, so this uninstaller cannot remove it by itself while its own
// file is still there. A tiny delayed 'rmdir' (it only removes an EMPTY folder, so other DriveVault programs are never touched) finishes the job.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  ResultCode: Integer;
begin
  if CurUninstallStep = usPostUninstall then
  begin
    RemoveDir(ExpandConstant('{localappdata}\DriveVault\MasterPro\installers'));
    Exec(ExpandConstant('{cmd}'), '/C ping 127.0.0.1 -n 4 >nul & rmdir "' + ExpandConstant('{app}\Common') + '" & rmdir "' + ExpandConstant('{app}') + '"', '', SW_HIDE, ewNoWait, ResultCode);
  end;
end;
