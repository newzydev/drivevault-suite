    function warning(code) {
        if (code === "bookmarks") return s("warnBookmarks")
        if (code === "forms") return s("warnForms")
        if (code === "encrypted") return s("warnEncrypted")
        if (code.indexOf("linksRemoved:") === 0) return f("warnLinks", code.substring(13))
        if (code.indexOf("cropTooBig:") === 0) return f("warnCrop", code.substring(11))
        return code
    }
    function s(key) {
        const e = table[key]
        if (!e)
            return key
        return lang === "th" ? e[1] : e[0]
    }
    function f(key, arg) { return s(key).replace("%1", arg) }
    function f2(key, a, b) { return s(key).replace("%1", a).replace("%2", b) }
    function error(code) {
        return s(code === "format" ? "errFormat" : code === "file" ? "errFile" : code === "tooLarge" ? "errTooLarge" : "errUnknown")
    }
