; DriveVault Video Editor Pro - Windows installer (Inno Setup 6.x).
; Built by scripts\package.ps1, which passes AppVersion, StageDir and OutputDir.

#ifndef AppVersion
  #define AppVersion "0.1.0"
#endif
#ifndef StageDir
  #error StageDir must point at the deployed application folder (see scripts\package.ps1)
#endif
#ifndef OutputDir
  #define OutputDir "..\..\dist"
#endif

#define AppName "DriveVault Video Editor Pro"
#define AppExe "DriveVaultVideoEditorPro.exe"
#define AppPublisher "DriveVault"
; Suite layout (see docs\suite-integration.md): every DriveVault product lives in its own folder below a shared "DriveVault" folder,
; so a future "DriveVault Master Pro" hub can find, install and update them all.
#define ProductFolder "DriveVault Video Editor Pro"
#define ProductKey "VideoEditorPro"
#define AccentColor "#8B5CF6"

[Setup]
; AppId identifies the product across versions - never change it once released.
AppId={{6E1B7A52-4C3D-4F7E-9A3B-D17E5A0C2F11}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
VersionInfoVersion={#AppVersion}.0
VersionInfoProductName={#AppName}
VersionInfoCompany={#AppPublisher}
VersionInfoDescription={#AppName} Setup
DefaultDirName={autopf}\DriveVault\Common\{#ProductFolder}
DefaultGroupName=DriveVault
DisableProgramGroupPage=yes
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName={#AppName}
SetupIconFile=..\..\resources\icons\app.ico
OutputDir={#OutputDir}
OutputBaseFilename=DriveVault-Video-Editor-Pro-Setup-x64
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
; Windows 10 or later, 64-bit only.
MinVersion=10.0
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; All users by default (C:\Program Files\DriveVault\...): administrator rights are asked once. Users without them can choose "just for me"
; in the dialog, and tests / the hub can pass /CURRENTUSER or /ALLUSERS.
PrivilegesRequired=admin
PrivilegesRequiredOverridesAllowed=dialog commandline
ShowLanguageDialog=yes
UsePreviousLanguage=no
LanguageDetectionMethod=uilanguage
CloseApplications=yes
RestartApplications=no
ChangesAssociations=yes
; The licence page shows the English or the Thai agreement (generated by shared\scripts\make-license.ps1)
WizardImageFile=wizard-large.bmp
WizardSmallImageFile=wizard-small.bmp

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"; LicenseFile: "license-en.txt"
Name: "thai"; MessagesFile: "compiler:Languages\Thai.isl"; LicenseFile: "license-th.txt"

[CustomMessages]
english.AssocComponent=Associate .dvproj project files with {#AppName}
english.DesktopTask=Create a &desktop shortcut
english.InstallingMaster=Installing DriveVault Master Pro (the hub for all DriveVault programs)...
english.KeepDataPrompt=Do you also want to delete your settings, logs, auto-save copies and cache?%n%nYour projects and exported videos are never deleted.%n%nChoose No to keep them (recommended if you plan to reinstall).
thai.AssocComponent=เชื่อมโยงไฟล์โปรเจกต์ .dvproj กับ {#AppName}
thai.InstallingMaster=กำลังติดตั้ง DriveVault Master Pro (ศูนย์รวมโปรแกรม DriveVault ทั้งหมด)...
thai.DesktopTask=สร้างทางลัดบน&เดสก์ท็อป
thai.KeepDataPrompt=ต้องการลบการตั้งค่า ไฟล์บันทึก สำเนาบันทึกอัตโนมัติ และแคช ด้วยหรือไม่?%n%nโปรเจกต์และวิดีโอที่ส่งออกของคุณจะไม่ถูกลบเด็ดขาด%n%nเลือก "No/ไม่" เพื่อเก็บไว้ (แนะนำหากจะติดตั้งใหม่)

[Components]
Name: "main"; Description: "{#AppName}"; Types: full compact custom; Flags: fixed
Name: "assoc"; Description: "{cm:AssocComponent}"; Types: full

[Tasks]
Name: "desktopicon"; Description: "{cm:DesktopTask}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Everything produced by windeployqt, the executable and the license folder.
Source: "{#StageDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Components: main
#ifdef MasterSetup
; DriveVault Master Pro (the hub of the suite) travels inside every program installer and is installed first when it is missing or older.
Source: "{#MasterSetup}"; DestDir: "{tmp}"; DestName: "MasterProSetup.exe"; Flags: deleteafterinstall; Check: NeedMaster
#endif

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\{#AppExe}"; WorkingDir: "{app}"
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon

[Registry]
; Product registration for the DriveVault hub (HKA = HKLM for all-users installs, HKCU for per-user installs).
Root: HKA; Subkey: "Software\DriveVault"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "Software\DriveVault\Products"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "Software\DriveVault\Products\{#ProductKey}"; ValueType: string; ValueName: "DisplayName"; ValueData: "{#AppName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\DriveVault\Products\{#ProductKey}"; ValueType: string; ValueName: "Version"; ValueData: "{#AppVersion}"
Root: HKA; Subkey: "Software\DriveVault\Products\{#ProductKey}"; ValueType: string; ValueName: "InstallDir"; ValueData: "{app}"
Root: HKA; Subkey: "Software\DriveVault\Products\{#ProductKey}"; ValueType: string; ValueName: "Executable"; ValueData: "{app}\{#AppExe}"
Root: HKA; Subkey: "Software\DriveVault\Products\{#ProductKey}"; ValueType: string; ValueName: "Manifest"; ValueData: "{app}\product.json"
Root: HKA; Subkey: "Software\DriveVault\Products\{#ProductKey}"; ValueType: string; ValueName: "AccentColor"; ValueData: "{#AccentColor}"
Root: HKA; Subkey: "Software\DriveVault\Products\{#ProductKey}"; ValueType: string; ValueName: "Publisher"; ValueData: "{#AppPublisher}"
Root: HKA; Subkey: "Software\DriveVault\Products\{#ProductKey}"; ValueType: string; ValueName: "Uninstaller"; ValueData: "{uninstallexe}"
; .dvproj association (HKA = HKCU for per-user installs, HKLM for all-users installs).
Root: HKA; Subkey: "Software\Classes\.dvproj"; ValueType: string; ValueData: "DriveVault.Project"; Flags: uninsdeletevalue uninsdeletekeyifempty; Components: assoc
Root: HKA; Subkey: "Software\Classes\DriveVault.Project"; ValueType: string; ValueData: "DriveVault Video Editor Project"; Flags: uninsdeletekey; Components: assoc
Root: HKA; Subkey: "Software\Classes\DriveVault.Project\DefaultIcon"; ValueType: string; ValueData: "{app}\{#AppExe},0"; Components: assoc
Root: HKA; Subkey: "Software\Classes\DriveVault.Project\shell\open\command"; ValueType: string; ValueData: """{app}\{#AppExe}"" ""%1"""; Components: assoc

[Run]
#ifdef MasterSetup
; Same scope (all users / current user) and language as this setup; the hub lives in the suite folder, the parent of this program's folder.
Filename: "{tmp}\MasterProSetup.exe"; Parameters: "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART {code:ScopeSwitch} /DIR=""{code:SuiteDir}"" /LANG={language}"; StatusMsg: "{cm:InstallingMaster}"; Flags: waituntilterminated; Check: NeedMaster
#endif
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent

[Code]
// ---- DriveVault Master Pro (hub) -------------------------------------------------------------------------------------------------
// The suite folder (where Master Pro lives) is the parent of the "Common" folder that holds every program:
// <suite>\Common\<program>. If the user chose a folder that is not below a "Common" folder, its parent is used.
function SuiteDir(Param: String): String;
var
  P: String;
begin
  P := ExtractFileDir(ExpandConstant('{app}'));
  if CompareText(ExtractFileName(P), 'Common') = 0 then
    P := ExtractFileDir(P);
  Result := P;
end;

function ScopeSwitch(Param: String): String;
begin
  if IsAdminInstallMode then
    Result := '/ALLUSERS'
  else
    Result := '/CURRENTUSER';
end;

function VersionPart(var S: String): Integer;
var
  P: Integer;
begin
  P := Pos('.', S);
  if P = 0 then
  begin
    Result := StrToIntDef(S, 0);
    S := '';
  end
  else
  begin
    Result := StrToIntDef(Copy(S, 1, P - 1), 0);
    S := Copy(S, P + 1, Length(S));
  end;
end;

function CompareVer(A, B: String): Integer;
var
  I, X, Y: Integer;
begin
  Result := 0;
  for I := 1 to 4 do
  begin
    X := VersionPart(A);
    Y := VersionPart(B);
    if X <> Y then
    begin
      if X < Y then Result := -1 else Result := 1;
      Exit;
    end;
  end;
end;

// Version of an installed, working Master Pro (all users or current user); '' when there is none.
function InstalledMasterVersion(): String;
var
  Exe, V: String;
begin
  Result := '';
  if RegQueryStringValue(HKLM64, 'Software\DriveVault\MasterPro', 'Executable', Exe) and FileExists(Exe) and
     RegQueryStringValue(HKLM64, 'Software\DriveVault\MasterPro', 'Version', V) then
    Result := V
  else if RegQueryStringValue(HKCU64, 'Software\DriveVault\MasterPro', 'Executable', Exe) and FileExists(Exe) and
          RegQueryStringValue(HKCU64, 'Software\DriveVault\MasterPro', 'Version', V) then
    Result := V;
end;

function NeedMaster(): Boolean;
var
  V: String;
begin
  V := InstalledMasterVersion();
#ifdef MasterVersion
  Result := (V = '') or (CompareVer(V, '{#MasterVersion}') < 0);
#else
  Result := False;
#endif
end;

// Uninstall: program files, shortcuts and the registry entries above are removed automatically.
// User projects are never touched. Settings / logs / cache are only removed if the user agrees.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataDir: String;
begin
  if CurUninstallStep = usPostUninstall then
  begin
    DataDir := ExpandConstant('{localappdata}\DriveVault\VideoEditorPro');
    if DirExists(DataDir) then
    begin
      // Silent uninstalls keep user data (MsgBox returns the default, IDNO, when suppressed).
      if MsgBox(CustomMessage('KeepDataPrompt'), mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
      begin
        DelTree(DataDir, True, True, True);
        RemoveDir(ExpandConstant('{localappdata}\DriveVault'));
      end;
    end;
  end;
end;
